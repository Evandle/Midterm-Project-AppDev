@* One product tile. Used on Home now, and on Merch later.
   Rank is optional: pass it to show the black number badge (1, 2, 3...). *@

<a href="item/@Product.Id" class="group block">
    <div class="relative aspect-square overflow-hidden rounded-lg bg-sky-50">
        <img src="@Product.ImagePath" alt="@Product.Name" loading="lazy"
             class="size-full object-cover transition duration-300 group-hover:scale-105" />

        @if (Rank is not null)
        {
            <span class="absolute left-0 top-0 flex size-10 items-center justify-center bg-black font-bold text-white">@Rank</span>
        }
    </div>

    <h3 class="mt-3 text-sm text-gray-800 group-hover:underline">@Product.Name</h3>
    <p class="mt-1 text-sm font-semibold text-brand">@Product.PriceText</p>

    @if (Product.IsSoldOut)
    {
        <span class="mt-1 inline-block bg-gray-500 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">Sold out</span>
    }
</a>

@code {
    [Parameter, EditorRequired] public Product Product { get; set; } = default!;
    [Parameter] public int? Rank { get; set; }
}
