@page "/cart"
@inject CartService CartSvc

<PageTitle>Cart</PageTitle>

<section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold">Your cart</h1>

    @if (orderTotal is not null)
    {
        @* ---------- Shown right after Checkout ---------- *@
        <div class="mt-8 max-w-xl border border-green-200 bg-green-50 p-6 text-green-900" role="status">
            <h2 class="text-xl font-bold">Order placed</h2>
            <p class="mt-2">Thanks! Your order of @orderCount item(s) for @Money(orderTotal.Value) is confirmed.</p>
            <p class="mt-1 text-sm">This is a demo, so no payment was taken and nothing was saved.</p>
            <a href="merch" class="mt-6 inline-block bg-black px-6 py-3 font-semibold text-white hover:bg-brand">Keep shopping</a>
        </div>
    }
    else if (CartSvc.Items.Count == 0)
    {
        @* ---------- Empty cart ---------- *@
        <div class="mt-8 rounded-lg border border-dashed border-gray-300 p-12 text-center">
            <p class="font-semibold">Your cart is empty.</p>
            <a href="merch" class="mt-4 inline-block bg-black px-6 py-3 font-semibold text-white hover:bg-brand">Browse merch</a>
        </div>
    }
    else
    {
        <div class="mt-8 grid gap-10 lg:grid-cols-[1fr_20rem]">

            @* ---------- Cart lines ---------- *@
            <ul class="divide-y divide-gray-200 border-y border-gray-200">
                @foreach (var item in CartSvc.Items)
                {
                    var product = item.Product;

                    <li class="flex gap-4 py-5">
                        <a href="item/@product.Id" class="size-24 shrink-0 overflow-hidden rounded-lg bg-sky-50">
                            <img src="@product.ImagePath" alt="@product.Name" class="size-full object-cover" />
                        </a>

                        <div class="flex flex-1 flex-col justify-between gap-3 sm:flex-row sm:items-center">
                            <div>
                                <a href="item/@product.Id" class="font-medium hover:underline">@product.Name</a>
                                <p class="text-sm text-gray-500">@product.PriceText each</p>
                            </div>

                            <div class="flex items-center gap-4">
                                <div class="flex items-center border border-gray-300">
                                    <button type="button" aria-label="Decrease quantity"
                                            @onclick="() => CartSvc.SetQuantity(product.Id, item.Quantity - 1)"
                                            disabled="@(item.Quantity <= 1)"
                                            class="size-9 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40">&minus;</button>
                                    <span class="w-9 text-center">@item.Quantity</span>
                                    <button type="button" aria-label="Increase quantity"
                                            @onclick="() => CartSvc.SetQuantity(product.Id, item.Quantity + 1)"
                                            disabled="@(item.Quantity >= CartService.MaxPerItem)"
                                            class="size-9 hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-40">+</button>
                                </div>

                                <span class="w-20 text-right font-semibold">@Money(item.LineTotal)</span>

                                <button type="button" aria-label="@($"Remove {product.Name}")"
                                        @onclick="() => CartSvc.Remove(product.Id)"
                                        class="text-gray-400 hover:text-brand">&#10005;</button>
                            </div>
                        </div>
                    </li>
                }
            </ul>

            @* ---------- Summary ---------- *@
            <aside class="h-fit border border-gray-200 p-6">
                <h2 class="text-lg font-bold">Order summary</h2>

                <dl class="mt-4 space-y-2 text-sm">
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Items</dt>
                        <dd>@CartSvc.Count</dd>
                    </div>
                    <div class="flex justify-between">
                        <dt class="text-gray-500">Shipping</dt>
                        <dd>Calculated at checkout</dd>
                    </div>
                </dl>

                <p class="mt-4 flex justify-between border-t border-gray-200 pt-4 text-lg font-bold">
                    <span>Subtotal</span>
                    <span>@Money(CartSvc.Subtotal)</span>
                </p>

                <button type="button" @onclick="Checkout"
                        class="mt-6 w-full bg-black py-3 font-bold text-white hover:bg-brand">Checkout</button>
                <button type="button" @onclick="CartSvc.Clear"
                        class="mt-3 w-full text-sm text-gray-500 underline hover:text-brand">Clear cart</button>
                <p class="mt-3 text-center text-xs text-gray-400">Demo only. No payment is taken.</p>
            </aside>
        </div>
    }
</section>

@code {
    private decimal? orderTotal;   // null until the visitor presses Checkout
    private int orderCount;

    private static string Money(decimal value) => $"${value:0.00}";

    // Remember what was ordered for the message, then empty the cart.
    private void Checkout()
    {
        orderTotal = CartSvc.Subtotal;
        orderCount = CartSvc.Count;
        CartSvc.Clear();
    }
}
