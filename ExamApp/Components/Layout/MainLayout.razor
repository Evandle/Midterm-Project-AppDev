@inherits LayoutComponentBase
@implements IDisposable
@inject CartService Cart

@* Sticky header: logo and icons on top, category links underneath (see NavMenu). *@
<header class="sticky top-0 z-40 bg-white">
    <div class="border-b border-gray-200">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6">

            <a href="/" class="flex items-center gap-2 text-xl font-bold tracking-widest">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="size-7" aria-hidden="true">
                    <circle cx="12" cy="12" r="8" />
                    <circle cx="12" cy="12" r="2" />
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4" />
                </svg>
                VERITAS
            </a>

            <div class="flex items-center gap-5">
                @* The search box lives on the Merch page, so this goes there *@
                <a href="merch" aria-label="Search the store" class="hover:text-brand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" />
                        <path d="M20 20l-4-4" />
                    </svg>
                </a>

                <button type="button" aria-label="Account" class="hover:text-brand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21c0-4 4-6 8-6s8 2 8 6" />
                    </svg>
                </button>

                @* The number comes from the shared cart and updates by itself *@
                <a href="cart" aria-label="@($"Cart, {Cart.Count} items")" class="relative hover:text-brand">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-6" aria-hidden="true">
                        <path d="M6 8h12l1 12H5L6 8z" />
                        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                    </svg>
                    <span class="absolute -right-2 -top-2 flex size-5 items-center justify-center rounded-full bg-black text-xs font-bold text-white">@Cart.Count</span>
                </a>
            </div>
        </div>
    </div>

    <NavMenu />
</header>

<main>
    @Body
</main>

<footer class="bg-gray-100">
    <div class="mx-auto max-w-7xl px-4 py-10 text-sm text-gray-600 sm:px-6">
        <p class="font-bold tracking-widest text-black">VERITAS</p>
        <p class="mt-2">Official merch and the monthly Lucky Box.</p>
        <p class="mt-6">&copy; @DateTime.Now.Year VERITAS. All rights reserved.</p>
    </div>
</footer>

@* Blazor shows this bar if the app crashes. Keep it. *@
<div id="blazor-error-ui" class="hidden fixed inset-x-0 bottom-0 bg-yellow-200 p-3">
    An unhandled error has occurred.
    <a href="" class="reload underline">Reload</a>
    <a class="dismiss cursor-pointer">&#10005;</a>
</div>

@code {
    // Redraw the header whenever the cart changes, and stop listening when the layout goes away.
    protected override void OnInitialized() => Cart.OnChange += HandleCartChanged;

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Cart.OnChange -= HandleCartChanged;
}
